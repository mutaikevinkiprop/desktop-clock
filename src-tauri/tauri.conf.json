{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Clock",
  "version": "1.0.0",
  "identifier": "com.desktopclock.widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Desktop Clock",
        "url": "index.html?window=widget",
        "width": 520,
        "height": 200,
        "minWidth": 200,
        "minHeight": 90,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "center": false,
        "visible": false,
        "focus": true,
        "dragDropEnabled": true
      },
      {
        "label": "settings",
        "title": "Desktop Clock - Settings",
        "url": "index.html?window=settings",
        "width": 900,
        "height": 660,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "maximizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Desktop Clock",
    "copyright": "Copyright (c) 2026 Desktop Clock",
    "category": "Utility",
    "shortDescription": "A beautiful desktop digital clock widget",
    "longDescription": "A lightweight, highly customizable digital clock widget that lives on your Windows desktop. Supports multiple time zones, themes, precise multi-monitor centering and full appearance customization.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "allowDowngrades": true,
      "signCommand": "node ./sign-windows.cjs %1",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "licenseFile": "../LICENSE"
  }
}
